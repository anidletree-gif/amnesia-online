<?xml version="1.0" encoding="utf-8"?>
<!-- 房间界面：完全对齐网页端 gamePanel 的卡片结构
     ① 房间头卡(⌘房间号 + 预设标签 + ✕退出)  ② 在场人员卡(标题+玩家网格+开始按钮)
     ③ 行动卡(动态)  ④ 记录片段卡(聊天+输入) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ═══ ① 房间头卡：⌘ 房间号 | 预设标签 + ✕ 退出 ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/memory_card_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:text="⌘"
                android:textColor="@color/text_primary"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvRoomInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:text="----"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPhaseInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/preset_tag_bg"
                android:fontFamily="monospace"
                android:maxLines="1"
                android:paddingStart="8dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp"
                android:text="等待中"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <Button
                android:id="@+id/btnLeave"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/memory_btn_danger_selector"
                android:minWidth="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="✕"
                android:textColor="@color/danger_text"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ═══ ② 在场人员卡 ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/memory_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:text="◈在场人员"
                android:textColor="@color/accent_gold"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 我的身份行 -->
            <TextView
                android:id="@+id/tvMyCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />

            <!-- 玩家徽章：3 列网格（对齐网页端 grid-cols-3） -->
            <GridLayout
                android:id="@+id/playerGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:columnCount="3"
                android:rowCount="0" />

            <!-- 状态提示（人数 / 等待） -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="连接中…"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <!-- 开始按钮（仅房主可见，对齐网页端 startGameBtn） -->
            <Button
                android:id="@+id/btnStart"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/memory_btn_selector"
                android:minWidth="0dp"
                android:stateListAnimator="@null"
                android:text="等待其他人员…"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- ═══ ③ 行动卡（动态，初始隐藏；夜晚/白天/投票/结算时显示） ═══ -->
        <LinearLayout
            android:id="@+id/actionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/memory_card_bg"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvActionTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:letterSpacing="0.08"
                android:text="◈行动"
                android:textColor="@color/accent_gold"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/actionArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />
        </LinearLayout>

        <!-- ═══ ④ 记录片段卡 ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/memory_card_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.15"
                    android:text="☷记录片段"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnRules"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:background="@drawable/memory_btn_selector"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:stateListAnimator="@null"
                    android:text="◈规则"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- 聊天记录：固定高度 150dp（对齐网页端 chat-log） -->
            <ScrollView
                android:id="@+id/chatScroll"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/chat_log_bg"
                android:fillViewport="true"
                android:padding="10dp"
                android:scrollbars="none">

                <TextView
                    android:id="@+id/chatLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_chat"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
            </ScrollView>

            <!-- 输入行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputChat"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/memory_input_selector"
                    android:hint="@string/game_chat_hint"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text_input"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/memory_btn_selector"
                    android:minWidth="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:stateListAnimator="@null"
                    android:text="↗"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>